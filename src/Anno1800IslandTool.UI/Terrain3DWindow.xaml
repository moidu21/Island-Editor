<Window x:Class="Anno1800IslandTool.UI.Terrain3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:Anno1800IslandTool.UI.Rendering"
        Title="Terrain 3D v46.46 — peinture par topologie"
        Width="1780"
        Height="1020"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10" ItemHeight="30">
            <TextBlock Text="Source 3D" VerticalAlignment="Center"/>
            <ComboBox x:Name="SourceModeComboBox" Width="285" Margin="8,0,0,0" SelectionChanged="ViewSettingsChanged">
                <ComboBoxItem Content="LOD brut exact"/>
                <ComboBoxItem Content="Mesh brut fusionné du LOD"/>
                <ComboBoxItem Content="Page mesh brute sélectionnée"/>
                <ComboBoxItem Content="Surface reconstruite lissée du LOD"/>
                <ComboBoxItem Content="Page reconstruite lissée"/>
                <ComboBoxItem Content="Comparaison page brute / lissée / coarse"/>
                <ComboBoxItem Content="Coarse dérivée des meshes (debug)"/>
            </ComboBox>
            <TextBlock Text="LOD" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="LodComboBox" Width="90" Margin="8,0,0,0" SelectionChanged="ViewSettingsChanged"/>
            <TextBlock Text="Relief" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="HeightScaleSlider" Width="160" Minimum="0.2" Maximum="4.0" Value="1.0" SmallChange="0.1" TickFrequency="0.2" IsSnapToTickEnabled="False" ValueChanged="ViewSettingsChanged"/>
            <TextBlock x:Name="HeightScaleValueText" Margin="8,0,0,0" VerticalAlignment="Center" Width="50"/>
            <CheckBox x:Name="ShowPageBoundsCheckBox" Content="Afficher bords de page" IsChecked="True" Margin="16,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="ShowMeshPointsCheckBox" Content="Afficher points page sélectionnée" IsChecked="False" Margin="12,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="ShowWireframeCheckBox" Content="Afficher wireframe" IsChecked="False" Margin="12,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="ShowDirtyRegionCheckBox" Content="Afficher dirty region" IsChecked="True" Margin="12,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="IgnoreEmptyPagesCheckBox" Content="Ignorer pages vides" IsChecked="True" Margin="16,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="OnlyDecodedPagesCheckBox" Content="Seulement pages décodées" IsChecked="True" Margin="12,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="InterPageWeldCheckBox" Content="Soudure inter-pages" IsChecked="True" Margin="12,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged"/>
            <CheckBox x:Name="FastLargeIslandModeCheckBox"
                      Content="Mode grande île (rendu GPU / calcul différé)"
                      IsChecked="True"
                      Margin="12,4,0,0"
                      ToolTip="Conserve le rendu Direct3D 11 pendant le pinceau et regroupe la reconstruction de scène, les normales, la synchronisation coarse et le rafraîchissement des listes au relâchement. Désactive pour retrouver l'aperçu recalculé pendant chaque mouvement."/>
            <TextBlock Text="Reconstr." Margin="16,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="ReconstructionMethodComboBox" Width="160" Margin="8,0,0,0" SelectionChanged="ViewSettingsChanged">
                <ComboBoxItem Content="X/Z uniques"/>
                <ComboBoxItem Content="Grille régulière"/>
                <ComboBoxItem Content="Triangulation brute"/>
            </ComboBox>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Outil" VerticalAlignment="Center"/>
            <ComboBox x:Name="BrushModeComboBox" Width="150" Margin="8,0,0,0" SelectionChanged="BrushSettingsChanged">
                <ComboBoxItem Content="Navigation"/>
                <ComboBoxItem Content="Raise"/>
                <ComboBoxItem Content="Lower"/>
                <ComboBoxItem Content="Smooth"/>
                <ComboBoxItem Content="Flatten"/>
            </ComboBox>
            <TextBlock Text="Forme" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="BrushShapeComboBox" Width="110" Margin="8,0,0,0" SelectionChanged="BrushSettingsChanged">
                <ComboBoxItem Content="Cercle"/>
                <ComboBoxItem Content="Carré"/>
                <ComboBoxItem Content="Rectangle"/>
            </ComboBox>
            <TextBlock Text="Rayon" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="BrushRadiusSlider" Width="140" Minimum="0.25" Maximum="240" Value="24" SmallChange="0.25" TickFrequency="0.25" IsSnapToTickEnabled="False" ValueChanged="BrushSettingsChanged"/>
            <TextBlock x:Name="BrushRadiusText" Margin="8,0,0,0" Width="40" VerticalAlignment="Center"/>
            <TextBlock Text="Rect. L" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Largeur complète du pinceau rectangle, en unités logiques de terrain."/>
            <Slider x:Name="BrushRectWidthSlider" Width="105" Minimum="1" Maximum="320" Value="48" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="BrushSettingsChanged"/>
            <TextBlock x:Name="BrushRectWidthText" Margin="6,0,0,0" Width="38" VerticalAlignment="Center"/>
            <TextBlock Text="Rect. H" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Longueur complète du pinceau rectangle, en unités logiques de terrain."/>
            <Slider x:Name="BrushRectLengthSlider" Width="105" Minimum="1" Maximum="320" Value="96" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="BrushSettingsChanged"/>
            <TextBlock x:Name="BrushRectLengthText" Margin="6,0,0,0" Width="38" VerticalAlignment="Center"/>
            <TextBlock Text="Intensité" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Slider x:Name="BrushStrengthSlider" Width="140" Minimum="0.1" Maximum="400" Value="18" SmallChange="0.1" TickFrequency="0.5" ValueChanged="BrushSettingsChanged"/>
            <TextBlock x:Name="BrushStrengthText" Margin="8,0,0,0" Width="50" VerticalAlignment="Center"/>
            <TextBlock Text="Falloff" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="BrushFalloffComboBox" Width="120" Margin="8,0,0,0" SelectionChanged="BrushSettingsChanged">
                <ComboBoxItem Content="Linéaire"/>
                <ComboBoxItem Content="Doux"/>
                <ComboBoxItem Content="Plat"/>
            </ComboBox>
            <TextBlock Text="Zone" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <ComboBox x:Name="ZoneActionComboBox" Width="105" Margin="6,0,0,0" SelectionChanged="BrushSettingsChanged" Visibility="Collapsed" ToolTip="Outil Zone hauteur retiré de l'interface en v40.8.">
                <ComboBoxItem Content="Monter"/>
                <ComboBoxItem Content="Descendre"/>
                <ComboBoxItem Content="Aplatir"/>
            </ComboBox>
            <Button Width="110" Height="28" Margin="16,0,0,0" Click="TopViewButton_Click">Vue haut</Button>
            <Button Width="110" Height="28" Margin="8,0,0,0" Click="IsoViewButton_Click">Vue iso</Button>
            <Button Width="120" Height="28" Margin="8,0,0,0" Click="FitSceneButton_Click">Cadrer scène</Button>
            <Button Width="140" Height="28" Margin="8,0,0,0" Click="FocusSelectionButton_Click">Cadrer sélection</Button>
            <Button Width="205" Height="28" Margin="12,0,0,0" Click="OpenDirect3DGpuEditorButton_Click">Éditeur GPU Direct3D 11...</Button>
            <CheckBox x:Name="ShowBrushOnTerrainCheckBox" Content="Rayon 3D sur terrain" IsChecked="True" Margin="12,4,0,0" Checked="BrushSettingsChanged" Unchecked="BrushSettingsChanged" ToolTip="v40.8 : dessine le rayon du pinceau directement sur la surface 3D, en plus du contour écran."/>
            <CheckBox x:Name="AdaptiveTopologyCheckBox" Content="Topologie source v39.1 (X/Z + indices du mesh édité)" IsChecked="False" IsEnabled="False" Margin="16,4,0,0"/>
            <CheckBox x:Name="RebuildSurfaceAttributesCheckBox" Content="Normales recalculées / UV conservés" IsChecked="True" IsEnabled="False" Margin="12,4,0,0"/>
            <CheckBox x:Name="SyncAllMeshLodsCheckBox" Content="Synchroniser tous les LOD mesh éditables" IsChecked="True" Margin="12,4,0,0"/>
            <CheckBox x:Name="SyncAllNormalHeightPagesCheckBox" Content="Forcer toutes les height/normal pages" IsChecked="True" Margin="12,4,0,0"/>
            <CheckBox x:Name="IslandExpansionModeCheckBox" Content="Extension île hors mesh" IsChecked="False" Margin="12,4,0,0" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="v42 : ajoute une surface fantôme pour peindre hors mesh existante. La validation conserve la topologie, ajoute les triangles manquants seulement dans ActiveMapGrid.bits et peut mettre à jour MaterialMap/tintmaps/gameplay depuis ce masque."/>
            <CheckBox x:Name="AutoSyncMaterialsFromHeightCheckBox" Content="Maj matériaux zones modifiées" IsChecked="True" Margin="12,4,0,0" ToolTip="v42 : après validation terrain, met à jour MaterialIDs2/MaterialAlphas2 seulement dans les cellules ActiveMapGrid.bits concernées, puis régénère les tintmaps."/>
            <TextBlock Text="Cell." Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="IslandExpansionCellsTextBox" Width="38" Height="24" Margin="4,0,0,0" Text="1" ToolTip="Nombre de cellules ActiveMapGrid à ajouter. 1 cellule = 8 unités root = 256 unités RD3D."/>
            <Button Width="36" Height="28" Margin="4,0,0,0" Click="ExtendIslandLeftButton_Click" ToolTip="Étendre ActiveMapGrid.bits vers la gauche sans remplir le rectangle">←</Button>
            <Button Width="36" Height="28" Margin="4,0,0,0" Click="ExtendIslandTopButton_Click" ToolTip="Étendre ActiveMapGrid.bits vers le haut sans remplir le rectangle">↑</Button>
            <Button Width="36" Height="28" Margin="4,0,0,0" Click="ExtendIslandRightButton_Click" ToolTip="Étendre ActiveMapGrid.bits vers la droite sans remplir le rectangle">→</Button>
            <Button Width="36" Height="28" Margin="4,0,0,0" Click="ExtendIslandBottomButton_Click" ToolTip="Étendre ActiveMapGrid.bits vers le bas sans remplir le rectangle">↓</Button>
            <Button Width="170" Height="28" Margin="8,0,0,0" Click="PropagateMeshButton_Click">Valider LOD mesh courant</Button>
            <Button Width="190" Height="28" Margin="8,0,0,0" Click="PropagateNormalMapsButton_Click">Régénérer normalmaps</Button>
            <Button Width="180" Height="28" Margin="8,0,0,0" Click="PropagateTintMapsButton_Click">Régénérer tintmaps</Button>
            <Button Width="200" Height="28" Margin="8,0,0,0" Click="ValidateEntireTerrainButton_Click">Valider tout le terrain</Button>
            <Button Width="160" Height="28" Margin="8,0,0,0" Click="CommitToProjectButton_Click">Appliquer au projet</Button>
            <Button x:Name="PickRawPresetButton" Width="150" Height="28" Margin="8,0,0,0" IsEnabled="False" Click="PickRawPresetButton_Click">Piquer Raw3..Raw7</Button>
            <CheckBox x:Name="UsePickedRawPresetCheckBox" Content="Appliquer preset" IsChecked="False" IsEnabled="False" Margin="8,4,0,0"/>
            <Button Width="90" Height="28" Margin="8,0,0,0" Click="ClearRawPresetButton_Click">Effacer</Button>
            <TextBlock x:Name="PickedRawPresetTextBlock" Margin="8,0,0,0" Width="260" VerticalAlignment="Center" Text="Preset Raw3..Raw7 : aucun" TextWrapping="Wrap"/>
            <TextBlock Text="Seuil Y" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="DirtyHeightThresholdTextBox" Width="58" Height="24" Margin="6,0,0,0" Text="0"/>
            <Button Width="120" Height="28" Margin="6,0,0,0" Click="ValidateDirtyHeightButton_Click">Vérif dirty</Button>
            <Button Width="110" Height="28" Margin="8,0,0,0" Click="ResetEditedButton_Click">Réinitialiser</Button>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#B8B8B8" BorderThickness="1" Background="#0f0f12" Margin="0,0,10,0">
                <Grid ClipToBounds="True">
                    <rendering:DirectX11TerrainViewport x:Name="SceneViewport"
                                ClipToBounds="True"
                                MouseDown="SceneViewport_MouseDown"
                                MouseMove="SceneViewport_MouseMove"
                                MouseUp="SceneViewport_MouseUp"
                                MouseWheel="SceneViewport_MouseWheel"
                                SizeChanged="SceneViewport_SizeChanged"/>
                    <rendering:DirectX11Canvas x:Name="BrushOverlayCanvas"
                            ClipToBounds="True"
                            IsHitTestVisible="False"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,3"
                            Background="#B0000000" CornerRadius="3" IsHitTestVisible="False">
                        <TextBlock x:Name="MouseCoordinateTextBlock"
                                   Foreground="#E8F6FF"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Text="RD3D : hors terrain"/>
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,3"
                            Background="#B0000000" CornerRadius="3" IsHitTestVisible="False">
                        <TextBlock x:Name="ComputeStatusTextBlock"
                                   Foreground="#DFFFE4"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   MaxWidth="760"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="14"
                                   Text="Calcul CPU : initialisation&#x0a;GPU : initialisation"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="170"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Pages mesh" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Filtres :" VerticalAlignment="Center"/>
                        <TextBlock Text="LOD actif" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Margin="6,0,0,0" Text="(grille = LOD sélectionné + filtres)" Foreground="#666" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
                <DataGrid x:Name="MeshPagesDataGrid"
                          Grid.Row="1"
                          Margin="0,8,0,8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="MeshPagesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOD" Binding="{Binding Lod}" Width="60"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="55"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="55"/>
                        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Clusters" Binding="{Binding Clusters}" Width="70"/>
                        <DataGridTextColumn Header="Vertices" Binding="{Binding Vertices}" Width="80"/>
                        <DataGridTextColumn Header="Indices" Binding="{Binding Indices}" Width="80"/>
                        <DataGridTextColumn Header="Triangles" Binding="{Binding Triangles}" Width="80"/>
                        <DataGridTextColumn Header="Résumé" Binding="{Binding Summary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="Détails / vertex sample" FontWeight="SemiBold"/>
                <TextBox x:Name="PageDetailsTextBox"
                         Grid.Row="3"
                         Margin="0,8,0,8"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="4" Text="Propagation / comparaison 3D / reconstruction" FontWeight="SemiBold"/>
                <Grid Grid.Row="5" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MeshPropagationTextBox"
                             Grid.Column="0"
                             Margin="0,0,8,0"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                    <TabControl Grid.Column="1" Margin="0,0,0,0">
                        <TabItem Header="Normal locale">
                            <Border BorderBrush="#B8B8B8" BorderThickness="1" Background="#111114">
                                <DockPanel Margin="6">
                                    <TextBlock DockPanel.Dock="Top" Text="Preview normalmap locale" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <rendering:DirectX11Image x:Name="RegeneratedNormalPreviewImage" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="Crop coarse">
                            <Border BorderBrush="#B8B8B8" BorderThickness="1" Background="#111114">
                                <DockPanel Margin="6">
                                    <TextBlock DockPanel.Dock="Top" Text="Crop coarse de la page sélectionnée" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <rendering:DirectX11Image x:Name="SelectedCoarseCropPreviewImage" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="Page reconstruite">
                            <Border BorderBrush="#B8B8B8" BorderThickness="1" Background="#111114">
                                <DockPanel Margin="6">
                                    <TextBlock DockPanel.Dock="Top" Text="Page reconstruite" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <rendering:DirectX11Image x:Name="SelectedReconstructedPreviewImage" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                        </TabItem>
                        <TabItem Header="Diff">
                            <Border BorderBrush="#B8B8B8" BorderThickness="1" Background="#111114">
                                <DockPanel Margin="6">
                                    <TextBlock DockPanel.Dock="Top" Text="Diff coarse vs page reconstruite" Margin="0,0,0,6" FontWeight="SemiBold"/>
                                    <rendering:DirectX11Image x:Name="SelectedDiffPreviewImage" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
                <TextBox x:Name="SceneSummaryTextBox"
                         Grid.Row="6"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="#555"
                   Text="v42 terrain 3D : extension d’île via masque ActiveMapGrid.bits précis, sans remplissage rectangulaire. Mesh/MaterialMap/GameData/normalmaps/tintmaps sont dérivés du masque actif autant que possible ; les nouveaux triangles ne sont injectés que dans les cellules actives hors footprint vanilla. Flatten prend la hauteur du centre du pinceau. X/Z, indices, nombre/ordre des vertices et Raw3..7 viennent du mesh courant/édité ; Raw1/Y, UsedMaterialBits et normal/height pages sont resynchronisés. Navigation = outil Navigation. Peinture = outil actif + clic gauche. Pan = clic droit, zoom = molette."/>
    </Grid>
</Window>
