<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:Anno1800IslandTool.UI.Rendering" xmlns:hx="http://helix-toolkit.org/wpf/SharpDX" x:Class="Anno1800IslandTool.UI.TerrainMaterialMapLargeWindow" Title="Anno1800IslandTool v46.89 - matériaux carrelés et menus organisés" Height="1000" Width="1780" WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="390"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,0,10,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <UniformGrid Columns="2">
            <Button x:Name="UndoMaterialButton" Margin="2" Height="30" IsEnabled="False" Click="UndoMaterialButton_Click">↶ Annuler</Button>
            <Button x:Name="RedoMaterialButton" Margin="2" Height="30" IsEnabled="False" Click="RedoMaterialButton_Click">↷ Rétablir</Button>
          </UniformGrid>
          <Button x:Name="ApplyMaterialEditsButton" Height="36" Click="ApplyMaterialEditsButton_Click" FontWeight="Bold">Appliquer au projet</Button>
        </StackPanel>
        <TabControl x:Name="MaterialToolsTabs">
          <TabItem Header="Peindre">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MenuScrollViewer_PreviewMouseWheel">
              <StackPanel>
                <TextBlock Text="Vue agrandie matériaux" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <TextBlock Text="Vue affichée" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ViewModeComboBox" Height="28" DisplayMemberPath="Label" SelectionChanged="ViewModeComboBox_SelectionChanged"/>
                <TextBlock Text="Peinture manuelle ou répartition automatique selon la forme du terrain." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                <Separator Margin="0,12,0,12"/>
                <TextBlock Text="Outils peinture matériaux" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="Palette terrain (Type=0)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="PaintMaterialComboBox" Height="28" DisplayMemberPath="ComboLabel" SelectionChanged="PaintMaterialComboBox_SelectionChanged"/>
                <Button x:Name="LoadMaterialSetButton" Height="28" Margin="0,6,0,0" Click="LoadMaterialSetButton_Click">Charger materialset...</Button>
                <TextBlock Margin="0,6,0,2" Text="Jeu de matériaux (material_sets)" FontWeight="SemiBold"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="92" Height="28" Margin="6,0,0,0" Click="UseEmbeddedMaterialSetButton_Click">Utiliser</Button>
                  <ComboBox x:Name="EmbeddedMaterialSetComboBox" Height="28" IsTextSearchEnabled="True" IsEditable="True" IsReadOnly="True" SelectionChanged="EmbeddedMaterialSetComboBox_SelectionChanged" ToolTip="Jeux de matériaux inclus dans le programme"/>
                </DockPanel>
                <TextBlock Text="Bibliothèque incluse dans le programme" Foreground="#315D31" Margin="0,3,0,0"/>
                <CheckBox x:Name="UpdateRd3dMaterialSetCheckBox" Content="Inscrire ce materialset dans rd3d.xml / export" IsChecked="True" Margin="0,4,0,0"/>
                <TextBlock x:Name="MaterialSetStatusTextBlock" Text="Materialset courant : projet" TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                <CheckBox x:Name="BeachProtectionCheckBox" Margin="0,6,0,0" IsChecked="{Binding ProtectBeachAreas, Mode=TwoWay}" Content="Protéger les zones de plage créées" ToolTip="Protection géographique : le sable ailleurs reste modifiable. Une petite marge conserve les palettes partagées aux bords."/>
                <CheckBox x:Name="PaintModeCheckBox" Content="Mode peinture activé" IsChecked="True" Margin="0,10,0,0" Checked="PaintModeCheckBox_CheckedChanged" Unchecked="PaintModeCheckBox_CheckedChanged"/>
                <CheckBox x:Name="PickupNextClickCheckBox" Content="Pickup : le prochain clic prélève la cellule" Margin="0,6,0,0"/>
                <CheckBox x:Name="UsePickedCellBrushCheckBox" Content="Peindre avec la cellule pickup / cellule ci-dessous" Margin="0,6,0,0"/>
                <TextBlock Text="Source peinture" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <ComboBox x:Name="CellBrushSourceComboBox" Height="28" SelectionChanged="CellBrushSourceComboBox_SelectionChanged">
                  <ComboBoxItem Content="Matériau simple" Tag="simple" IsSelected="True"/>
                  <ComboBoxItem Content="Cellule terrain personnalisée" Tag="cell"/>
                </ComboBox>
                <Separator Margin="0,12,0,12"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Rayon" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BrushRadiusValueTextBlock" DockPanel.Dock="Right" Text="8 px"/>
                </DockPanel>
                <Slider x:Name="BrushRadiusSlider" Minimum="1" Maximum="128" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BrushRadiusSlider_ValueChanged"/>
                <CheckBox x:Name="BrushFalloffCheckBox" Content="Falloff doux" IsChecked="True" Margin="0,6,0,0"/>
                <DockPanel Margin="0,10,0,0">
                  <TextBlock DockPanel.Dock="Left" Text="Force" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BrushStrengthValueTextBlock" DockPanel.Dock="Right" Text="18 / 31"/>
                </DockPanel>
                <Slider x:Name="BrushStrengthSlider" Minimum="1" Maximum="31" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BrushStrengthSlider_ValueChanged"/>
                <ComboBox x:Name="BrushModeComboBox" Height="28" Margin="0,8,0,0"/>
                <Separator Margin="0,12,0,12"/>
                <Separator Margin="0,12,0,12"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Zoom vue" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ZoomValueTextBlock" DockPanel.Dock="Right" Text="200 %"/>
                </DockPanel>
                <Slider x:Name="ZoomSlider" Minimum="50" Maximum="800" Value="200" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged"/>
                <TextBlock Text="Astuce : Ctrl + molette dans la carte ajuste aussi le zoom." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                <Separator Margin="0,12,0,12"/>
                <TextBlock Text="Historique des outils" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="MaterialHistoryStatusTextBlock" Text="Aucune modification à annuler." TextWrapping="Wrap" Foreground="#315D31" Margin="0,3,0,8"/>
                <Button x:Name="ClearPickupButton" Height="30" Margin="0,6,0,0" Click="ClearPickupButton_Click">Effacer pickup</Button>
                <TextBlock x:Name="PickupStatusTextBlock" Text="Pickup : aucun. Clic droit sur la carte pour prélever." TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="PaintStatusTextBlock" Text="Prêt. Le cercle rouge s'affiche seulement en mode peinture, dans la vue modifiable." TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Separator Margin="0,12,0,12"/>
                <TextBlock Text="Résumé" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="SummaryTextBox" MinHeight="120" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Cellule / matériau" FontWeight="SemiBold" Margin="0,12,0,4"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Topologie">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MenuScrollViewer_PreviewMouseWheel">
              <StackPanel>
                <Expander Header="Peinture automatique par topologie" IsExpanded="True">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Utilise la pente et la courbure locales, jamais l’altitude absolue." TextWrapping="Wrap" Foreground="#315D31" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="105" Text="Surface plate"/>
                      <ComboBox x:Name="TopologyFlatMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
                    </DockPanel>
                    <StackPanel Margin="0,8,0,8">
                      <CheckBox x:Name="FlatTilingCheckBox" Content="Motif carrelé sur les terrains plats"/>
                      <TextBlock Text="Deux matériaux du biome, sans modification du relief." TextWrapping="Wrap" Margin="0,4,0,4"/>
                      <ComboBox x:Name="FlatTilingMaterialComboBox" DisplayMemberPath="ComboLabel" Height="26"/>
                      <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Taille des carreaux (cases)" Width="190" DockPanel.Dock="Left"/>
                        <TextBox x:Name="FlatTileSizeTextBox" Text="4" Height="24"/>
                      </DockPanel>
                      <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Contraste (0–31)" Width="190" DockPanel.Dock="Left"/>
                        <TextBox x:Name="FlatTileContrastTextBox" Text="12" Height="24"/>
                      </DockPanel>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="105" Text="Pente douce"/>
                      <ComboBox x:Name="TopologyGentleMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="105" Text="Pente forte"/>
                      <ComboBox x:Name="TopologySteepMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="105" Text="Crête"/>
                      <ComboBox x:Name="TopologyRidgeMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="105" Text="Creux"/>
                      <ComboBox x:Name="TopologyHollowMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
                    </DockPanel>
                    <TextBlock Text="Sensibilité" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="130" Text="Plat jusqu’à"/>
                      <TextBox x:Name="TopologyFlatSlopeTextBox" Text="0.18" Height="24"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="130" Text="Pente forte dès"/>
                      <TextBox x:Name="TopologySteepSlopeTextBox" Text="1.15" Height="24"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="130" Text="Crête/creux dès"/>
                      <TextBox x:Name="TopologyCurvatureTextBox" Text="0.35" Height="24"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Width="130" Text="Rayon (cases)"/>
                      <TextBox x:Name="TopologyRadiusTextBox" Text="1" Height="24"/>
                    </DockPanel>
                    <TextBlock x:Name="TopologyProfileTextBlock" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5"/>
          <CheckBox x:Name="NativeCellsCheckBox" Content="Cellules multicouches du biome" IsChecked="True" ToolTip="Mélanges inspirés des îles d’origine. Un choix manuel de matériau remplace la recette de la catégorie concernée."/>
          <CheckBox x:Name="EmergedOnlyCheckBox" Content="Limiter aux terres émergées" IsChecked="True"/>
          <CheckBox x:Name="TopologyPreserveWaterBeachCheckBox" Content="Exclure les cellules uniquement eau / plage" ToolTip="Décocher pour repeindre aussi les anciennes plages et les fonds marins aplatis. Une sous-couche de sable sous de l’herbe ne bloque pas la peinture." IsChecked="False" Margin="0,4,0,0"/>
                    <CheckBox x:Name="TopologyBlendCheckBox" Content="Mélanger au lieu de remplacer" Margin="0,4,0,0"/>
                    <DockPanel Margin="0,6,0,0">
                      <TextBlock DockPanel.Dock="Left" Width="55" Text="Force"/>
                      <Slider x:Name="TopologyStrengthSlider" Minimum="1" Maximum="31" Value="31" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>
                    <Button x:Name="ShowTopologyViewButton" Height="30" Margin="0,8,0,0" Click="ShowTopologyViewButton_Click">Afficher la vue topologique</Button>
                    <Button x:Name="ApplyTopologyButton" Height="30" Margin="0,6,0,0" Click="ApplyTopologyButton_Click">Mettre à jour image depuis topologie</Button>
                    <TextBlock x:Name="TopologyStatusTextBlock" Text="Vue topologique prête." TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Réglages">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MenuScrollViewer_PreviewMouseWheel">
              <StackPanel>
                <Expander Header="Rendu avec les données du jeu" IsExpanded="False" Margin="0,10,0,0">
                  <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Sélectionne le dossier data extrait du jeu. Les textures DDS du materialset actif seront chargées directement." TextWrapping="Wrap" Foreground="#315D31"/>
                    <TextBox x:Name="GameDataPathTextBox" Height="27" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="NoWrap"/>
                    <UniformGrid Columns="2" Margin="0,5,0,0">
                      <Button Height="28" Margin="0,0,3,0" Click="SelectGameDataPathButton_Click">Choisir data...</Button>
                      <Button Height="28" Margin="3,0,0,0" Click="ClearGameDataPathButton_Click">Effacer le chemin</Button>
                    </UniformGrid>
                    <CheckBox x:Name="UseGameTexturesCheckBox" Content="Utiliser les textures du jeu dans la vue 3D" IsChecked="True" Margin="0,6,0,0" Checked="UseGameTexturesCheckBox_Changed" Unchecked="UseGameTexturesCheckBox_Changed"/>
                    <CheckBox x:Name="UseIslandTintMapsCheckBox" Content="Appliquer aussi les tintmaps DDS de l’île" IsChecked="True" Margin="0,4,0,0" Checked="UseGameTexturesCheckBox_Changed" Unchecked="UseGameTexturesCheckBox_Changed"/>
                    <TextBlock x:Name="GameDataStatusTextBlock" Text="Aucun dossier de données sélectionné : couleurs techniques utilisées." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                  </StackPanel>
                </Expander>
                <Expander Header="Créer / former une cellule terrain" IsExpanded="False" Margin="0,10,0,0">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Un pickup remplit ces slots. Tu peux ensuite modifier les IDs/alphas puis peindre avec cette cellule." TextWrapping="Wrap" Foreground="#666"/>
                    <DockPanel Margin="0,6,0,4">
                      <Button x:Name="SetSelectedMaterialInCellSlotButton" DockPanel.Dock="Right" Width="118" Height="26" Click="SetSelectedMaterialInCellSlotButton_Click">Mettre l'ID</Button>
                      <ComboBox x:Name="CellEditorTargetSlotComboBox" DockPanel.Dock="Right" Width="70" Height="26" Margin="6,0,6,0">
                        <ComboBoxItem Content="Slot 0" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="Slot 1" Tag="1"/>
                        <ComboBoxItem Content="Slot 2" Tag="2"/>
                        <ComboBoxItem Content="Slot 3" Tag="3"/>
                        <ComboBoxItem Content="Slot 4" Tag="4"/>
                        <ComboBoxItem Content="Slot 5" Tag="5"/>
                      </ComboBox>
                      <TextBlock Text="Palette sélectionnée →" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="CellEditorSourceTextBlock" Text="Cellule source : aucune" Margin="0,6,0,4"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Slot" FontWeight="SemiBold"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="Material ID" FontWeight="SemiBold"/>
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="Alpha" FontWeight="SemiBold"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="0" VerticalAlignment="Center"/>
                      <TextBox x:Name="CellSlot0IdTextBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBox x:Name="CellSlot0AlphaTextBox" Grid.Row="1" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="1" VerticalAlignment="Center"/>
                      <TextBox x:Name="CellSlot1IdTextBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBox x:Name="CellSlot1AlphaTextBox" Grid.Row="2" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBlock Grid.Row="3" Grid.Column="0" Text="2" VerticalAlignment="Center"/>
                      <TextBox x:Name="CellSlot2IdTextBox" Grid.Row="3" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBox x:Name="CellSlot2AlphaTextBox" Grid.Row="3" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBlock Grid.Row="4" Grid.Column="0" Text="3" VerticalAlignment="Center"/>
                      <TextBox x:Name="CellSlot3IdTextBox" Grid.Row="4" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBox x:Name="CellSlot3AlphaTextBox" Grid.Row="4" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBlock Grid.Row="5" Grid.Column="0" Text="4" VerticalAlignment="Center"/>
                      <TextBox x:Name="CellSlot4IdTextBox" Grid.Row="5" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBox x:Name="CellSlot4AlphaTextBox" Grid.Row="5" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBlock Grid.Row="6" Grid.Column="0" Text="5" VerticalAlignment="Center"/>
                      <TextBox x:Name="CellSlot5IdTextBox" Grid.Row="6" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                      <TextBox x:Name="CellSlot5AlphaTextBox" Grid.Row="6" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                    </Grid>
                    <TextBlock x:Name="CellEditorStatusTextBlock" Text="Cellule prête : fais un pickup ou saisis les slots." TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button x:Name="UseCellEditorButton" Width="150" Height="28" Click="UseCellEditorButton_Click">Utiliser cette cellule</Button>
                      <Button x:Name="ClearCellEditorButton" Width="110" Height="28" Margin="6,0,0,0" Click="ClearCellEditorButton_Click">Vider</Button>
                    </StackPanel>
                    <Separator Margin="0,10,0,8"/>
                    <StackPanel Visibility="Collapsed">
                      <TextBlock Text="Utiliser cette cellule pour les seuils hauteur" FontWeight="SemiBold" Margin="0,0,0,4"/>
                      <TextBlock Text="Assigne la cellule éditée à une classe. L'outil hauteur → matériaux utilisera alors cette empreinte complète au lieu d'un simple ID ou du pattern vanilla-like." TextWrapping="Wrap" Foreground="#666"/>
                      <ComboBox x:Name="CellEditorCoastRoleComboBox" Height="26" Margin="0,6,0,0">
                        <ComboBoxItem Content="Eau profonde" Tag="deep" IsSelected="True"/>
                        <ComboBoxItem Content="Eau faible / corail" Tag="shallow"/>
                        <ComboBoxItem Content="Plage" Tag="beach"/>
                        <ComboBoxItem Content="Terre basse" Tag="lowland"/>
                        <ComboBoxItem Content="Roche pente" Tag="rock"/>
                      </ComboBox>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="AssignCellToCoastRoleButton" Width="150" Height="28" Click="AssignCellToCoastRoleButton_Click">Assigner au seuil</Button>
                        <Button x:Name="ClearCoastRoleCellsButton" Width="110" Height="28" Margin="6,0,0,0" Click="ClearCoastRoleCellsButton_Click">Vider seuils</Button>
                      </StackPanel>
                      <TextBlock x:Name="CoastRoleCellsStatusTextBlock" Text="Seuils : aucune cellule personnalisée assignée." TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Expander>
                <Button x:Name="ResetWorkingMapButton" Height="30" Margin="0,6,0,0" Click="ResetWorkingMapButton_Click">Réinitialiser la copie</Button>
                <Button x:Name="RefreshButton" Height="30" Margin="0,6,0,0" Click="RefreshButton_Click">Rafraîchir la vue</Button>
                <TextBox x:Name="CellDetailsTextBox" MinHeight="180" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Visibility="Collapsed">
                  <TextBlock Text="Seuils hauteur monde" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                  <TextBlock Text="Matériaux de transition" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Eau profonde"/>
                    <ComboBox x:Name="DeepWaterMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Eau faible"/>
                    <ComboBox x:Name="ShallowWaterMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Plage"/>
                    <ComboBox x:Name="BeachMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Terre basse"/>
                    <ComboBox x:Name="LowLandMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Roche pente"/>
                    <ComboBox x:Name="RockMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <TextBlock Text="Seuils" FontWeight="SemiBold" Margin="0,8,0,4"/>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="130" Text="Eau profonde ≤"/>
                    <TextBox x:Name="DeepWaterHeightTextBox" Text="-4.00" Height="24" TextChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="130" Text="Ligne eau ≤"/>
                    <TextBox x:Name="WaterLineHeightTextBox" Text="-1.00" Height="24" TextChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="130" Text="Plage ≤"/>
                    <TextBox x:Name="BeachMaxHeightTextBox" Text="0.80" Height="24" TextChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="130" Text="Terre basse ≤"/>
                    <TextBox x:Name="LowLandMaxHeightTextBox" Text="12.00" Height="24" TextChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Width="130" Text="Pente roche ≥"/>
                    <TextBox x:Name="RockSlopeThresholdTextBox" Text="1.15" Height="24" TextChanged="CoastControl_Changed"/>
                  </DockPanel>
                  <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Force transition" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CoastStrengthValueTextBlock" DockPanel.Dock="Right" Text="31 / 31"/>
                  </DockPanel>
                  <Slider x:Name="CoastStrengthSlider" Minimum="1" Maximum="31" Value="31" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CoastStrengthSlider_ValueChanged"/>
                  <CheckBox x:Name="CoastPaintRockCheckBox" Content="Peindre la roche sur pentes fortes" Margin="0,6,0,0" Checked="CoastControl_Changed" Unchecked="CoastControl_Changed"/>
                  <CheckBox x:Name="CoastBlendCheckBox" Content="Mélanger au lieu de remplacer dominant" Margin="0,4,0,0" Checked="CoastControl_Changed" Unchecked="CoastControl_Changed"/>
                  <CheckBox x:Name="CoastUseCellPatternTemplatesCheckBox" Content="Utiliser empreintes cellule vanilla" IsChecked="True" ToolTip="Peint des combinaisons MaterialIDs2 + MaterialAlphas2 complètes au lieu d'un seul ID; recommandé contre les carrés gris." Margin="0,4,0,0" Checked="CoastControl_Changed" Unchecked="CoastControl_Changed"/>
                  <Button x:Name="ShowCoastViewButton" Height="30" Margin="0,8,0,0" Click="ShowCoastViewButton_Click">Afficher la vue seuils</Button>
                  <Button x:Name="ApplyCoastTransitionButton" Height="30" Margin="0,6,0,0" Click="ApplyCoastTransitionButton_Click">Mettre à jour image peinture depuis seuils</Button>
                  <TextBlock x:Name="CoastStatusTextBlock" Text="Vue seuils prête." TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <Separator Margin="0,12,0,12"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" Padding="8">
      <DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,7">
          <Button x:Name="Show3DViewButton" Height="30" Margin="2" Click="Show3DViewButton_Click">Vue 3D DirectX</Button>
          <Button x:Name="Show2DViewButton" Height="30" Margin="2" Click="Show2DViewButton_Click">Vue 2D technique</Button>
          <Button Height="30" Margin="2" Click="FrameMaterial3DButton_Click">Cadrer le relief</Button>
          <TextBlock x:Name="Material3DRendererTextBlock" Margin="8,0" VerticalAlignment="Center" Text="Direct3D 11 : initialisation..."/>
        </UniformGrid>
        <TextBlock x:Name="ImageHintTextBlock" DockPanel.Dock="Top" Text="Clique pour inspecter. Clic droit ou mode Pickup pour prélever en vue peinture. Cliquer/glisser peint quand le mode peinture est activé." Margin="0,0,0,8"/>
        <Grid>
          <Border x:Name="Material3DHost" Background="#101217" BorderBrush="#555" BorderThickness="1">
            <hx:Viewport3DX x:Name="MaterialGpuViewport" BackgroundColor="#101217" ShowCoordinateSystem="True" ShowViewCube="True" EnableDpiScale="True" EnableSwapChainRendering="False" UseDefaultGestures="False" FXAALevel="Low" PreviewMouseMove="MaterialGpuViewport_PreviewMouseMove" PreviewMouseLeftButtonDown="MaterialGpuViewport_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="MaterialGpuViewport_PreviewMouseLeftButtonUp" PreviewMouseRightButtonDown="MaterialGpuViewport_PreviewMouseRightButtonDown" PreviewMouseWheel="MaterialGpuViewport_PreviewMouseWheel" MouseLeave="MaterialGpuViewport_MouseLeave">
              <hx:Viewport3DX.InputBindings>
                <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="RightClick"/>
                <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="MiddleClick"/>
              </hx:Viewport3DX.InputBindings>
              <hx:AmbientLight3D Color="#C8C8C8"/>
              <hx:DirectionalLight3D Color="#FFF4DE" Direction="-0.35,-0.8,-0.45"/>
              <hx:DirectionalLight3D Color="#AFC8F0" Direction="0.55,-0.25,0.35"/>
              <hx:GroupModel3D x:Name="MaterialTerrainGroup"/>
              <hx:LineGeometryModel3D x:Name="MaterialBrushRingModel" Color="#FFFFD400" Thickness="5" DepthBias="-150" IsHitTestVisible="False" IsRendering="False"/>
            </hx:Viewport3DX>
          </Border>
          <ScrollViewer x:Name="Material2DHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
            <Grid x:Name="MaterialMapCanvasGrid" RenderOptions.BitmapScalingMode="NearestNeighbor">
              <Grid.LayoutTransform>
                <ScaleTransform x:Name="MaterialMapScaleTransform" ScaleX="2" ScaleY="2"/>
              </Grid.LayoutTransform>
              <rendering:DirectX11Image x:Name="MaterialMapImage" Stretch="None" SnapsToDevicePixels="True" MouseLeftButtonDown="MaterialMapImage_MouseLeftButtonDown" MouseLeftButtonUp="MaterialMapImage_MouseLeftButtonUp" MouseRightButtonDown="MaterialMapImage_MouseRightButtonDown" MouseMove="MaterialMapImage_MouseMove" MouseLeave="MaterialMapImage_MouseLeave"/>
              <rendering:DirectX11Canvas x:Name="BrushOverlayCanvas" IsHitTestVisible="False" Width="{Binding ActualWidth, ElementName=MaterialMapImage}" Height="{Binding ActualHeight, ElementName=MaterialMapImage}">
                <Ellipse x:Name="BrushPreviewEllipse" Visibility="Collapsed" Stroke="#FFFF4040" StrokeThickness="1.5" Fill="#22FF4040"/>
              </rendering:DirectX11Canvas>
            </Grid>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
