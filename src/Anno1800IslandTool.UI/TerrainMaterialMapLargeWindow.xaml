<Window x:Class="Anno1800IslandTool.UI.TerrainMaterialMapLargeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anno1800IslandTool v44.9 - Matériaux / vue agrandie"
        Height="1000"
        Width="1780"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Vue agrandie matériaux" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>

                    <TextBlock Text="Vue affichée" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ViewModeComboBox"
                              Height="28"
                              DisplayMemberPath="Label"
                              SelectionChanged="ViewModeComboBox_SelectionChanged"/>
                    <TextBlock Text="La vue peinture modifie la carte. La vue seuils affiche une prévisualisation hauteur → matériaux." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <TextBlock Text="Outils peinture matériaux" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="Palette terrain (Type=0)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PaintMaterialComboBox"
                              Height="28"
                              DisplayMemberPath="ComboLabel"
                              SelectionChanged="PaintMaterialComboBox_SelectionChanged"/>
                    <Button x:Name="LoadMaterialSetButton"
                            Height="28"
                            Margin="0,6,0,0"
                            Click="LoadMaterialSetButton_Click">Charger materialset...</Button>
                    <CheckBox x:Name="UpdateRd3dMaterialSetCheckBox"
                              Content="Inscrire ce materialset dans rd3d.xml / export"
                              IsChecked="True"
                              Margin="0,4,0,0"/>
                    <TextBlock x:Name="MaterialSetStatusTextBlock"
                               Text="Materialset courant : projet"
                               TextWrapping="Wrap"
                               Foreground="#666"
                               Margin="0,4,0,0"/>

                    <CheckBox x:Name="PaintModeCheckBox"
                              Content="Mode peinture activé"
                              IsChecked="True"
                              Margin="0,10,0,0"
                              Checked="PaintModeCheckBox_CheckedChanged"
                              Unchecked="PaintModeCheckBox_CheckedChanged"/>
                    <CheckBox x:Name="PickupNextClickCheckBox"
                              Content="Pickup : le prochain clic prélève la cellule"
                              Margin="0,6,0,0"/>
                    <CheckBox x:Name="UsePickedCellBrushCheckBox"
                              Content="Peindre avec la cellule pickup / cellule ci-dessous"
                              Margin="0,6,0,0"/>

                    <TextBlock Text="Source peinture" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <ComboBox x:Name="CellBrushSourceComboBox" Height="28" SelectionChanged="CellBrushSourceComboBox_SelectionChanged">
                        <ComboBoxItem Content="Matériau simple" Tag="simple" IsSelected="True"/>
                        <ComboBoxItem Content="Cellule terrain personnalisée" Tag="cell"/>
                    </ComboBox>

                    <Expander Header="Créer / former une cellule terrain" IsExpanded="True" Margin="0,10,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Un pickup remplit ces slots. Tu peux ensuite modifier les IDs/alphas puis peindre avec cette cellule." TextWrapping="Wrap" Foreground="#666"/>
                            <DockPanel Margin="0,6,0,4">
                                <Button x:Name="SetSelectedMaterialInCellSlotButton"
                                        DockPanel.Dock="Right"
                                        Width="118"
                                        Height="26"
                                        Click="SetSelectedMaterialInCellSlotButton_Click">Mettre l'ID</Button>
                                <ComboBox x:Name="CellEditorTargetSlotComboBox" DockPanel.Dock="Right" Width="70" Height="26" Margin="6,0,6,0">
                                    <ComboBoxItem Content="Slot 0" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="Slot 1" Tag="1"/>
                                    <ComboBoxItem Content="Slot 2" Tag="2"/>
                                    <ComboBoxItem Content="Slot 3" Tag="3"/>
                                    <ComboBoxItem Content="Slot 4" Tag="4"/>
                                    <ComboBoxItem Content="Slot 5" Tag="5"/>
                                </ComboBox>
                                <TextBlock Text="Palette sélectionnée →" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="CellEditorSourceTextBlock" Text="Cellule source : aucune" Margin="0,6,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Slot" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Material ID" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Alpha" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="CellSlot0IdTextBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBox x:Name="CellSlot0AlphaTextBox" Grid.Row="1" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="1" VerticalAlignment="Center"/>
                                <TextBox x:Name="CellSlot1IdTextBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBox x:Name="CellSlot1AlphaTextBox" Grid.Row="2" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="CellSlot2IdTextBox" Grid.Row="3" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBox x:Name="CellSlot2AlphaTextBox" Grid.Row="3" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="3" VerticalAlignment="Center"/>
                                <TextBox x:Name="CellSlot3IdTextBox" Grid.Row="4" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBox x:Name="CellSlot3AlphaTextBox" Grid.Row="4" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="4" VerticalAlignment="Center"/>
                                <TextBox x:Name="CellSlot4IdTextBox" Grid.Row="5" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBox x:Name="CellSlot4AlphaTextBox" Grid.Row="5" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="CellSlot5IdTextBox" Grid.Row="6" Grid.Column="1" Height="24" Margin="0,2,6,2" TextChanged="CellEditor_TextChanged"/>
                                <TextBox x:Name="CellSlot5AlphaTextBox" Grid.Row="6" Grid.Column="2" Height="24" Margin="0,2,0,2" TextChanged="CellEditor_TextChanged"/>
                            </Grid>
                            <TextBlock x:Name="CellEditorStatusTextBlock" Text="Cellule prête : fais un pickup ou saisis les slots." TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="UseCellEditorButton" Width="150" Height="28" Click="UseCellEditorButton_Click">Utiliser cette cellule</Button>
                                <Button x:Name="ClearCellEditorButton" Width="110" Height="28" Margin="6,0,0,0" Click="ClearCellEditorButton_Click">Vider</Button>
                            </StackPanel>

                            <Separator Margin="0,10,0,8"/>
                            <TextBlock Text="Utiliser cette cellule pour les seuils hauteur" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Assigne la cellule éditée à une classe. L'outil hauteur → matériaux utilisera alors cette empreinte complète au lieu d'un simple ID ou du pattern vanilla-like." TextWrapping="Wrap" Foreground="#666"/>
                            <ComboBox x:Name="CellEditorCoastRoleComboBox" Height="26" Margin="0,6,0,0">
                                <ComboBoxItem Content="Eau profonde" Tag="deep" IsSelected="True"/>
                                <ComboBoxItem Content="Eau faible / corail" Tag="shallow"/>
                                <ComboBoxItem Content="Plage" Tag="beach"/>
                                <ComboBoxItem Content="Terre basse" Tag="lowland"/>
                                <ComboBoxItem Content="Roche pente" Tag="rock"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="AssignCellToCoastRoleButton" Width="150" Height="28" Click="AssignCellToCoastRoleButton_Click">Assigner au seuil</Button>
                                <Button x:Name="ClearCoastRoleCellsButton" Width="110" Height="28" Margin="6,0,0,0" Click="ClearCoastRoleCellsButton_Click">Vider seuils</Button>
                            </StackPanel>
                            <TextBlock x:Name="CoastRoleCellsStatusTextBlock" Text="Seuils : aucune cellule personnalisée assignée." TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Separator Margin="0,12,0,12"/>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Rayon" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BrushRadiusValueTextBlock" DockPanel.Dock="Right" Text="8 px"/>
                    </DockPanel>
                    <Slider x:Name="BrushRadiusSlider"
                            Minimum="1"
                            Maximum="128"
                            Value="8"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="BrushRadiusSlider_ValueChanged"/>
                    <CheckBox x:Name="BrushFalloffCheckBox" Content="Falloff doux" IsChecked="True" Margin="0,6,0,0"/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Force" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BrushStrengthValueTextBlock" DockPanel.Dock="Right" Text="18 / 31"/>
                    </DockPanel>
                    <Slider x:Name="BrushStrengthSlider"
                            Minimum="1"
                            Maximum="31"
                            Value="18"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="BrushStrengthSlider_ValueChanged"/>
                    <ComboBox x:Name="BrushModeComboBox" Height="28" Margin="0,8,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <TextBlock Text="Seuils hauteur monde" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="Matériaux de transition" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Eau profonde"/>
                        <ComboBox x:Name="DeepWaterMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Eau faible"/>
                        <ComboBox x:Name="ShallowWaterMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Plage"/>
                        <ComboBox x:Name="BeachMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Terre basse"/>
                        <ComboBox x:Name="LowLandMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Width="105" VerticalAlignment="Center" Text="Roche pente"/>
                        <ComboBox x:Name="RockMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel" SelectionChanged="CoastControl_Changed"/>
                    </DockPanel>

                    <TextBlock Text="Seuils" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Left" Width="130" Text="Eau profonde ≤"/><TextBox x:Name="DeepWaterHeightTextBox" Text="-4.00" Height="24" TextChanged="CoastControl_Changed"/></DockPanel>
                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Left" Width="130" Text="Ligne eau ≤"/><TextBox x:Name="WaterLineHeightTextBox" Text="-1.00" Height="24" TextChanged="CoastControl_Changed"/></DockPanel>
                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Left" Width="130" Text="Plage ≤"/><TextBox x:Name="BeachMaxHeightTextBox" Text="0.80" Height="24" TextChanged="CoastControl_Changed"/></DockPanel>
                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Left" Width="130" Text="Terre basse ≤"/><TextBox x:Name="LowLandMaxHeightTextBox" Text="12.00" Height="24" TextChanged="CoastControl_Changed"/></DockPanel>
                    <DockPanel Margin="0,0,0,4"><TextBlock DockPanel.Dock="Left" Width="130" Text="Pente roche ≥"/><TextBox x:Name="RockSlopeThresholdTextBox" Text="1.15" Height="24" TextChanged="CoastControl_Changed"/></DockPanel>

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Force transition" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CoastStrengthValueTextBlock" DockPanel.Dock="Right" Text="31 / 31"/>
                    </DockPanel>
                    <Slider x:Name="CoastStrengthSlider"
                            Minimum="1"
                            Maximum="31"
                            Value="31"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="CoastStrengthSlider_ValueChanged"/>
                    <CheckBox x:Name="CoastPaintRockCheckBox" Content="Peindre la roche sur pentes fortes" Margin="0,6,0,0" Checked="CoastControl_Changed" Unchecked="CoastControl_Changed"/>
                    <CheckBox x:Name="CoastBlendCheckBox" Content="Mélanger au lieu de remplacer dominant" Margin="0,4,0,0" Checked="CoastControl_Changed" Unchecked="CoastControl_Changed"/>
                    <CheckBox x:Name="CoastUseCellPatternTemplatesCheckBox"
                              Content="Utiliser empreintes cellule vanilla"
                              IsChecked="True"
                              ToolTip="Peint des combinaisons MaterialIDs2 + MaterialAlphas2 complètes au lieu d'un seul ID; recommandé contre les carrés gris."
                              Margin="0,4,0,0"
                              Checked="CoastControl_Changed"
                              Unchecked="CoastControl_Changed"/>
                    <Button x:Name="ShowCoastViewButton" Height="30" Margin="0,8,0,0" Click="ShowCoastViewButton_Click">Afficher la vue seuils</Button>
                    <Button x:Name="ApplyCoastTransitionButton" Height="30" Margin="0,6,0,0" Click="ApplyCoastTransitionButton_Click">Mettre à jour image peinture depuis seuils</Button>
                    <TextBlock x:Name="CoastStatusTextBlock" Text="Vue seuils prête." TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Zoom vue" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ZoomValueTextBlock" DockPanel.Dock="Right" Text="200 %"/>
                    </DockPanel>
                    <Slider x:Name="ZoomSlider"
                            Minimum="50"
                            Maximum="800"
                            Value="200"
                            TickFrequency="25"
                            IsSnapToTickEnabled="True"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock Text="Astuce : Ctrl + molette dans la carte ajuste aussi le zoom." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <Button x:Name="ApplyMaterialEditsButton" Height="30" Click="ApplyMaterialEditsButton_Click">Appliquer au projet</Button>
                    <Button x:Name="ResetWorkingMapButton" Height="30" Margin="0,6,0,0" Click="ResetWorkingMapButton_Click">Réinitialiser la copie</Button>
                    <Button x:Name="RefreshButton" Height="30" Margin="0,6,0,0" Click="RefreshButton_Click">Rafraîchir la vue</Button>
                    <Button x:Name="ClearPickupButton" Height="30" Margin="0,6,0,0" Click="ClearPickupButton_Click">Effacer pickup</Button>

                    <TextBlock x:Name="PickupStatusTextBlock"
                               Text="Pickup : aucun. Clic droit sur la carte pour prélever."
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <TextBlock x:Name="PaintStatusTextBlock"
                               Text="Prêt. Le cercle rouge s'affiche seulement en mode peinture, dans la vue modifiable."
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <Separator Margin="0,12,0,12"/>

                    <TextBlock Text="Résumé" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="SummaryTextBox"
                             MinHeight="120"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Cellule / matériau" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBox x:Name="CellDetailsTextBox"
                             MinHeight="180"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" BorderBrush="#CCC" BorderThickness="1" Padding="8">
            <DockPanel>
                <TextBlock x:Name="ImageHintTextBlock"
                           DockPanel.Dock="Top"
                           Text="Clique pour inspecter. Clic droit ou mode Pickup pour prélever en vue peinture. Cliquer/glisser peint quand le mode peinture est activé."
                           Margin="0,0,0,8"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                    <Grid x:Name="MaterialMapCanvasGrid"
                          RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="MaterialMapScaleTransform" ScaleX="2" ScaleY="2"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="MaterialMapImage"
                               Stretch="None"
                               SnapsToDevicePixels="True"
                               MouseLeftButtonDown="MaterialMapImage_MouseLeftButtonDown"
                               MouseLeftButtonUp="MaterialMapImage_MouseLeftButtonUp"
                               MouseRightButtonDown="MaterialMapImage_MouseRightButtonDown"
                               MouseMove="MaterialMapImage_MouseMove"
                               MouseLeave="MaterialMapImage_MouseLeave"/>
                        <Canvas x:Name="BrushOverlayCanvas"
                                IsHitTestVisible="False"
                                Width="{Binding ActualWidth, ElementName=MaterialMapImage}"
                                Height="{Binding ActualHeight, ElementName=MaterialMapImage}">
                            <Ellipse x:Name="BrushPreviewEllipse"
                                     Visibility="Collapsed"
                                     Stroke="#FFFF4040"
                                     StrokeThickness="1.5"
                                     Fill="#22FF4040"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
