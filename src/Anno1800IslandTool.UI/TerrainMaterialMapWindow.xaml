<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:Anno1800IslandTool.UI.Rendering" x:Class="Anno1800IslandTool.UI.TerrainMaterialMapWindow" Title="Anno1800IslandTool v46.77 - matériaux carrelés et menus organisés" Height="1080" Width="1520" WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="270"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="260"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,0,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Vue / peinture MaterialIDs2 + MaterialAlphas2. Les changements restent dans une copie de travail jusqu'au bouton Appliquer au projet." FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="SummaryTextBox" FontFamily="Consolas" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.4*"/>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Palette terrain (Type=0)" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <ComboBox x:Name="PaintMaterialComboBox" Height="28" DisplayMemberPath="ComboLabel" SelectionChanged="PaintMaterialComboBox_SelectionChanged"/>
          <DockPanel Margin="0,8,0,0">
            <Button x:Name="LoadMaterialSetButton" DockPanel.Dock="Left" Width="160" Height="28" Click="LoadMaterialSetButton_Click">Charger materialset...</Button>
            <TextBox x:Name="MaterialSetPathTextBox" Margin="8,0,0,0" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="UseEmbeddedMaterialSetButton" DockPanel.Dock="Right" Width="120" Height="28" Margin="8,0,0,0" Click="UseEmbeddedMaterialSetButton_Click">Utiliser</Button>
            <ComboBox x:Name="EmbeddedMaterialSetComboBox" Height="28" IsTextSearchEnabled="True" IsEditable="True" IsReadOnly="True" SelectionChanged="EmbeddedMaterialSetComboBox_SelectionChanged" ToolTip="Jeux de matériaux inclus dans le programme"/>
          </DockPanel>
          <TextBlock Margin="0,3,0,0" Text="material_sets intégré : synchronisé avec l’éditeur 3D GPU et MaterialSetFileName dans le RD3D." TextWrapping="Wrap" Foreground="#315D31"/>
          <CheckBox x:Name="UpdateRd3dMaterialSetCheckBox" Content="Inscrire ce materialset dans rd3d.xml / export" IsChecked="True" Margin="0,6,0,0"/>
          <CheckBox x:Name="BeachProtectionCheckBox" Margin="0,6,0,0" IsChecked="{Binding ProtectBeachAreas, Mode=TwoWay}" Content="Protéger les zones de plage créées (sable ailleurs modifiable)"/>
          <CheckBox x:Name="PaintModeCheckBox" Content="Mode peinture activé : cliquer/glisser sur la carte peint le matériau sélectionné ou le pickup" Margin="0,6,0,0" Checked="PaintModeCheckBox_CheckedChanged" Unchecked="PaintModeCheckBox_CheckedChanged"/>
          <CheckBox x:Name="PickupNextClickCheckBox" Content="Pickup : le prochain clic prélève la cellule complète" Margin="0,6,0,0"/>
          <CheckBox x:Name="UsePickedCellBrushCheckBox" Content="Peindre avec la cellule pickup (slots + alphas)" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="Rayon" FontWeight="SemiBold"/>
          <Slider x:Name="BrushRadiusSlider" Minimum="1" Maximum="64" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/>
          <TextBlock Text="Rayon 1 à 64 px"/>
          <CheckBox x:Name="BrushFalloffCheckBox" Content="Falloff doux" IsChecked="True" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="12,0,0,0">
          <TextBlock Text="Force" FontWeight="SemiBold"/>
          <Slider x:Name="BrushStrengthSlider" Minimum="1" Maximum="31" Value="18" TickFrequency="1" IsSnapToTickEnabled="True"/>
          <TextBlock Text="Force 1 à 31"/>
          <ComboBox x:Name="BrushModeComboBox" Height="28" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="12,0,0,0">
          <Button x:Name="OpenLargeMaterialMapWindowButton" Height="30" Click="OpenLargeMaterialMapWindowButton_Click">Ouvrir vue agrandie...</Button>
          <Button x:Name="ApplyMaterialEditsButton" Height="30" Margin="0,6,0,0" Click="ApplyMaterialEditsButton_Click">Appliquer au projet</Button>
          <Button x:Name="ResetWorkingMapButton" Height="30" Margin="0,6,0,0" Click="ResetWorkingMapButton_Click">Réinitialiser la copie</Button>
          <Button x:Name="RefreshStatsButton" Height="30" Margin="0,6,0,0" Click="RefreshStatsButton_Click">Rafraîchir stats</Button>
          <Button x:Name="ClearPickupButton" Height="30" Margin="0,6,0,0" Click="ClearPickupButton_Click">Effacer pickup</Button>
          <TextBlock x:Name="PickupStatusTextBlock" Text="Pickup : aucun. Clic droit sur la carte pour prélever." TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock x:Name="PaintStatusTextBlock" Text="Aucune peinture appliquée." TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" BorderBrush="#B9D3EA" BorderThickness="1" Padding="8" Margin="0,0,0,10" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*"/>
          <ColumnDefinition Width="2.2*"/>
          <ColumnDefinition Width="1.4*"/>
          <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="v25 - Transition hauteur → matériau" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Remplit eau profonde / eau faible / plage / terre basse depuis la heightmap GameData, sans modifier la hauteur." TextWrapping="Wrap"/>
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Text="Eau profonde"/>
            <ComboBox x:Name="DeepWaterMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Text="Eau faible"/>
            <ComboBox x:Name="ShallowWaterMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Text="Plage"/>
            <ComboBox x:Name="BeachMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="Matériaux de transition" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Text="Terre basse"/>
            <ComboBox x:Name="LowLandMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Text="Roche pente"/>
            <ComboBox x:Name="RockMaterialComboBox" Height="26" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <CheckBox x:Name="CoastPaintRockCheckBox" Content="Peindre la roche sur pentes fortes" Margin="0,8,0,0"/>
          <CheckBox x:Name="CoastBlendCheckBox" Content="Mélanger au lieu de remplacer dominant" Margin="0,4,0,0"/>
          <CheckBox x:Name="CoastUseCellPatternTemplatesCheckBox" Content="Utiliser empreintes cellule vanilla" IsChecked="True" ToolTip="Peint des combinaisons MaterialIDs2 + MaterialAlphas2 complètes au lieu d'un seul ID; recommandé contre les carrés gris." Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="12,0,0,0">
          <TextBlock Text="Seuils hauteur monde" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Width="110" Text="Eau profonde ≤"/>
            <TextBox x:Name="DeepWaterHeightTextBox" Text="-4.00" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="110" Text="Ligne eau ≤"/>
            <TextBox x:Name="WaterLineHeightTextBox" Text="-1.00" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="110" Text="Plage ≤"/>
            <TextBox x:Name="BeachMaxHeightTextBox" Text="0.80" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="110" Text="Terre basse ≤"/>
            <TextBox x:Name="LowLandMaxHeightTextBox" Text="12.00" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="110" Text="Pente roche ≥"/>
            <TextBox x:Name="RockSlopeThresholdTextBox" Text="1.15" Height="24"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="12,0,0,0">
          <TextBlock Text="Application" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Width="80" VerticalAlignment="Center" Text="Force"/>
            <Slider x:Name="CoastStrengthSlider" Minimum="1" Maximum="31" Value="31" TickFrequency="1" IsSnapToTickEnabled="True"/>
          </DockPanel>
          <Button x:Name="PreviewCoastTransitionButton" Height="30" Margin="0,8,0,0" Click="PreviewCoastTransitionButton_Click">Prévisualiser zones</Button>
          <Button x:Name="ApplyCoastTransitionButton" Height="30" Margin="0,6,0,0" Click="ApplyCoastTransitionButton_Click">Mettre à jour image peinture depuis seuils</Button>
          <TextBlock x:Name="CoastStatusTextBlock" Text="Prêt : règle les matériaux et seuils puis applique à la copie de travail." TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="3" BorderBrush="#B8D8B8" BorderThickness="1" Padding="8" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.7*"/>
          <ColumnDefinition Width="1.5*"/>
          <ColumnDefinition Width="1.25*"/>
          <ColumnDefinition Width="1.55*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Peinture automatique par topologie" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="Classe le relief par pente et courbure locale, sans utiliser son altitude." TextWrapping="Wrap" Margin="0,3,0,6"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Width="105" Text="Surface plate"/>
            <ComboBox x:Name="TopologyFlatMaterialComboBox" Height="25" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="105" Text="Pente douce"/>
            <ComboBox x:Name="TopologyGentleMaterialComboBox" Height="25" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <StackPanel Margin="0,8,0,8">
            <CheckBox x:Name="FlatTilingCheckBox" Content="Motif carrelé sur les terrains plats"/>
            <TextBlock Text="Deux matériaux du biome, sans modification du relief." TextWrapping="Wrap" Margin="0,4,0,4"/>
            <ComboBox x:Name="FlatTilingMaterialComboBox" DisplayMemberPath="ComboLabel" Height="26"/>
            <DockPanel Margin="0,4,0,0">
              <TextBlock Text="Taille des carreaux (cases)" Width="190" DockPanel.Dock="Left"/>
              <TextBox x:Name="FlatTileSizeTextBox" Text="4" Height="24"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
              <TextBlock Text="Contraste (0–31)" Width="190" DockPanel.Dock="Left"/>
              <TextBox x:Name="FlatTileContrastTextBox" Text="12" Height="24"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="Matériaux selon la forme" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Width="90" Text="Pente forte"/>
            <ComboBox x:Name="TopologySteepMaterialComboBox" Height="25" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="90" Text="Crête"/>
            <ComboBox x:Name="TopologyRidgeMaterialComboBox" Height="25" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="90" Text="Creux"/>
            <ComboBox x:Name="TopologyHollowMaterialComboBox" Height="25" DisplayMemberPath="ComboLabel"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="12,0,0,0">
          <TextBlock Text="Sensibilité topologique" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Width="112" Text="Plat jusqu’à"/>
            <TextBox x:Name="TopologyFlatSlopeTextBox" Text="0.18" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="112" Text="Pente forte dès"/>
            <TextBox x:Name="TopologySteepSlopeTextBox" Text="1.15" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="112" Text="Crête/creux dès"/>
            <TextBox x:Name="TopologyCurvatureTextBox" Text="0.35" Height="24"/>
          </DockPanel>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="112" Text="Rayon analyse"/>
            <TextBox x:Name="TopologyRadiusTextBox" Text="2" Height="24"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="12,0,0,0">
          <CheckBox x:Name="TopologyPreserveWaterBeachCheckBox" Content="Préserver l’eau et les plages existantes" IsChecked="True"/>
          <CheckBox x:Name="TopologyBlendCheckBox" Content="Mélanger au lieu de remplacer" Margin="0,4,0,0"/>
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Width="55" Text="Force"/>
            <Slider x:Name="TopologyStrengthSlider" Minimum="1" Maximum="31" Value="31" TickFrequency="1" IsSnapToTickEnabled="True"/>
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="PreviewTopologyButton" Width="105" Height="28" Click="PreviewTopologyButton_Click">Prévisualiser</Button>
            <Button x:Name="ApplyTopologyButton" Margin="6,0,0,0" Height="28" Click="ApplyTopologyButton_Click">Mettre à jour l’image</Button>
          </DockPanel>
          <TextBlock x:Name="TopologyStatusTextBlock" Text="Prêt : aucune hauteur absolue utilisée." TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="1.2*"/>
      </Grid.ColumnDefinitions>
      <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Répartition des matériaux dominants" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DataGrid x:Name="DominantMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="DominantMaterialsDataGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Couleur" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Width="34" Height="18" BorderBrush="#888" BorderThickness="1" Background="{Binding Brush}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
              <DataGridTextColumn Header="Pixels" Binding="{Binding Count}" Width="90"/>
              <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="75"/>
              <DataGridTextColumn Header="Texture / objet" Binding="{Binding Label}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="8,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Cellule / matériau sélectionné" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox x:Name="CellDetailsTextBox" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="5" BorderBrush="#CCC" BorderThickness="1" Padding="8">
      <DockPanel>
        <TextBlock x:Name="ImageHintTextBlock" DockPanel.Dock="Top" Text="Clique pour inspecter. Clic droit ou mode Pickup pour prélever une cellule. Active le mode peinture pour modifier la copie de travail." Margin="0,0,0,8"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="MaterialMapImageGrid">
            <rendering:DirectX11Image x:Name="MaterialMapImage" Stretch="None" SnapsToDevicePixels="True" MouseLeftButtonDown="MaterialMapImage_MouseLeftButtonDown" MouseLeftButtonUp="MaterialMapImage_MouseLeftButtonUp" MouseRightButtonDown="MaterialMapImage_MouseRightButtonDown" MouseMove="MaterialMapImage_MouseMove" MouseLeave="MaterialMapImage_MouseLeave"/>
            <rendering:DirectX11Canvas x:Name="BrushOverlayCanvas" IsHitTestVisible="False" Width="{Binding ActualWidth, ElementName=MaterialMapImage}" Height="{Binding ActualHeight, ElementName=MaterialMapImage}">
              <Ellipse x:Name="BrushPreviewEllipse" Visibility="Collapsed" Stroke="#FFFF4040" StrokeThickness="1.5" Fill="#22FF4040"/>
            </rendering:DirectX11Canvas>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
