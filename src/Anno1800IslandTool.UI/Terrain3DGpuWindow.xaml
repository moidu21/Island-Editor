<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hx="http://helix-toolkit.org/wpf/SharpDX" x:Class="Anno1800IslandTool.UI.Terrain3DGpuWindow" Title="Terrain 3D GPU v46.89 - matériaux carrelés et menus organisés" Width="1500" Height="920" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="EditorControlsPanel" Grid.Column="0" BorderBrush="#60646C" BorderThickness="1" CornerRadius="4" Padding="10" Background="#F3F4F6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Height="36" Margin="0,4,0,6" FontWeight="Bold" Click="ValidateEntireTerrainButton_Click">Valider tout le terrain</Button>
          <Button Height="38" Margin="0,4,0,6" FontWeight="Bold" Click="ApplyButton_Click">Valider et fermer — prêt pour export</Button>
          <Button Height="34" Click="CancelButton_Click" ToolTip="Annule uniquement les retouches non validées. Les plages, empreintes et validations déjà appliquées sont conservées.">Fermer sans valider les retouches</Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
          <GroupBox Header="Outil actif" Margin="0,0,0,10">
            <StackPanel Margin="8">
              <ComboBox x:Name="BrushToolListBox" SelectionChanged="BrushToolListBox_SelectionChanged" FontSize="14" Height="36">
                <ComboBoxItem Padding="8" Content="🖐  Déplacer la vue"/>
                <ComboBoxItem Padding="8" Content="⬆  Monter le terrain"/>
                <ComboBoxItem Padding="8" Content="⬇  Creuser le terrain"/>
                <ComboBoxItem Padding="8" Content="≈  Lisser le terrain"/>
                <ComboBoxItem Padding="8" Content="▬  Aplatir (Flatten)"/>
                <ComboBoxItem Padding="8" Content="🎯  Prélever une hauteur"/>
                <ComboBoxItem Padding="8" Content="🏖  Créer une plage jouable"/>
                <ComboBoxItem Padding="8" Content="✚  Ajouter une zone d’île"/>
                <ComboBoxItem Padding="8" Content="✕  Retirer une zone d’île"/>
                <ComboBoxItem Padding="8" Content="🌲  Planter des arbres"/>
                <ComboBoxItem Padding="8" Content="🏖  Créer une plage depuis le maillage"/>
                <ComboBoxItem Padding="8" Content="🌊  Créer une rivière"/>
                <ComboBoxItem Padding="8" Content="⛏  Ajouter une mine"/>
                <ComboBoxItem Padding="8" Content="Ajouter un puits d’argile"/>
                <ComboBoxItem Padding="8" Content="Ajouter un puits de pétrole"/>
              </ComboBox>
              <Border Margin="0,8,0,0" Padding="7" Background="#FFF4CC" BorderBrush="#D5B95F" BorderThickness="1">
                <TextBlock x:Name="ActiveToolHelpTextBlock" TextWrapping="Wrap" Text="Navigation : glissez avec le bouton gauche ou droit pour tourner."/>
              </Border>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Historique des outils" Margin="0,0,0,10">
            <StackPanel Margin="8">
              <UniformGrid Columns="2">
                <Button x:Name="UndoButton" Margin="2" Height="32" IsEnabled="False" Click="UndoButton_Click">↶ Annuler</Button>
                <Button x:Name="RedoButton" Margin="2" Height="32" IsEnabled="False" Click="RedoButton_Click">↷ Rétablir</Button>
              </UniformGrid>
              <TextBlock x:Name="UndoStatusTextBlock" Margin="2,5,2,0" Text="Aucune modification à annuler." TextWrapping="Wrap" Foreground="#315D31" Visibility="Collapsed"/>
              <TextBlock Margin="2,3,2,0" Text="Raccourcis : Ctrl+Z et Ctrl+Y. Les 20 dernières actions avant application ou validation sont conservées." TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
        <TabControl x:Name="GpuToolTabs">
          <TabItem Header="Relief">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Expander Header="Régler le pinceau" Margin="0,0,0,10" IsExpanded="True">
                  <StackPanel Margin="8">
                    <DockPanel Margin="0,0,0,3">
                      <TextBlock Text="Rayon" VerticalAlignment="Center"/>
                      <TextBlock DockPanel.Dock="Right" Width="54" TextAlignment="Right" Text="{Binding ElementName=BrushRadiusSlider, Path=Value, StringFormat={}{0:0}}"/>
                    </DockPanel>
                    <Slider x:Name="BrushRadiusSlider" Minimum="8" Maximum="2048" Value="64" TickFrequency="32" ValueChanged="BrushRadiusSlider_ValueChanged"/>
                    <DockPanel Margin="0,10,0,3">
                      <TextBlock Text="Intensité" VerticalAlignment="Center"/>
                      <TextBlock DockPanel.Dock="Right" Width="54" TextAlignment="Right" Text="{Binding ElementName=BrushStrengthSlider, Path=Value, StringFormat={}{0:0.0}}"/>
                    </DockPanel>
                    <Slider x:Name="BrushStrengthSlider" Minimum="0.5" Maximum="800" Value="18" TickFrequency="10"/>
                    <DockPanel Margin="0,10,0,3">
                      <TextBlock Text="Motif" VerticalAlignment="Center"/>
                      <ComboBox x:Name="BrushPatternComboBox" DockPanel.Dock="Right" Width="150" SelectedIndex="0" SelectionChanged="BrushPatternComboBox_SelectionChanged">
                        <ComboBoxItem Content="Cercle"/>
                        <ComboBoxItem Content="Carré"/>
                        <ComboBoxItem Content="Losange"/>
                        <ComboBoxItem Content="Étoile"/>
                        <ComboBoxItem Content="Irrégulier naturel"/>
                      </ComboBox>
                    </DockPanel>
                    <CheckBox x:Name="SmoothFalloffCheckBox" Content="Bord progressif (monter / creuser / lisser)" IsChecked="True" Margin="0,10,0,0"/>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#555" Text="Aplatir applique toujours exactement la hauteur cible dans tout le motif."/>
                  </StackPanel>
                </Expander>
                <Expander Header="Hauteur cible" Margin="0,0,0,10" IsExpanded="True">
                  <StackPanel Margin="8">
                    <TextBlock x:Name="TargetHeightTextBlock" Text="Aucune hauteur prélevée" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Choisissez « Prélever une hauteur », cliquez sur l'île, puis utilisez Lisser ou Aplatir."/>
                    <Button Margin="0,8,0,0" Height="28" Click="ClearPickedHeightButton_Click">
                                Effacer la hauteur cible
                            </Button>
                  </StackPanel>
                </Expander>
                <Expander Header="Déplacement de la vue" Margin="0,0,0,10" IsExpanded="True">
                  <StackPanel Margin="8">
                    <UniformGrid Columns="3">
                      <Button Margin="2" Height="30" Click="TopViewButton_Click">Dessus</Button>
                      <Button Margin="2" Height="30" Click="IsoViewButton_Click">Isométrique</Button>
                      <Button Margin="2" Height="30" Click="FitViewButton_Click">Cadrer</Button>
                    </UniformGrid>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Souris : gauche en mode Déplacer = tourner • bouton droit = tourner • molette maintenue = déplacer • roulette = zoomer."/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Objets">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Expander x:Name="DepositsExpander" Header="Puits d’argile et de pétrole" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock Text="Choisissez l’outil Argile ou Pétrole, puis cliquez sur un terrain émergé. Chaque clic ajoute un emplacement. Pour le pétrole, placez plusieurs puits voisins pour former un gisement." TextWrapping="Wrap"/>
                    <TextBlock x:Name="DepositStatusTextBlock" Margin="0,8,0,8" TextWrapping="Wrap"/>
                    <Button Click="RemoveLastDepositButton_Click" Height="30">Retirer le dernier puits</Button>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Carré : argile. Losange : pétrole. Jaune : en attente ; gris : enregistré. Validez le terrain pour conserver les ajouts. Ctrl+Z / Ctrl+Y : annuler / rétablir. L’activation en jeu dépend des ressources de la session."/>
                  </StackPanel>
                </Expander>
                <Expander Header="Mines — emplacements de ressource" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <ComboBox x:Name="MineAssetComboBox" Margin="0,0,0,8"/>
                    <TextBlock Text="Sélectionnez l’outil Mine. Cliquez l’entrée sur un terrain accessible, puis la zone de travail dans la montagne. La ligne indique l’orientation. Choisissez une ressource adaptée à la session ; les ressources DLC nécessitent le DLC correspondant." TextWrapping="Wrap"/>
                    <TextBlock x:Name="MineStatusTextBlock" Margin="0,8,0,8" Text="Aucune mine en attente." TextWrapping="Wrap"/>
                    <Button Click="RemoveLastMineButton_Click" Height="30">Retirer le dernier placement</Button>
                    <TextBlock Text="Jaune : nouvelles mines. Gris : emplacements existants. Les ajouts sont enregistrés avec « Valider tout le terrain » ou « Valider et fermer ». Ctrl+Z permet d’annuler avant validation." Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
                <Expander Header="Créer une plage jouable" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock x:Name="BeachSelectionTextBlock" Text="Sélectionnez l’outil Plage, puis cliquez une fois près d’un bord extérieur ou intérieur." TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="86"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="Hauteur de plage" VerticalAlignment="Center"/>
                      <TextBox x:Name="BeachHeightTextBox" Grid.Row="0" Grid.Column="1" Margin="6,2" Text="104" TextChanged="BeachSettingsTextBox_TextChanged"/>
                      <TextBlock Grid.Row="1" Text="Fond sous l’eau" VerticalAlignment="Center"/>
                      <TextBox x:Name="BeachWaterDepthTextBox" Grid.Row="1" Grid.Column="1" Margin="6,2" Text="-2048" TextChanged="BeachSettingsTextBox_TextChanged"/>
                      <TextBlock Grid.Row="2" Text="Largeur du sable vers l’eau" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <TextBox x:Name="BeachLandWidthTextBox" Grid.Row="2" Grid.Column="1" Margin="6,2" Text="96" TextChanged="BeachSettingsTextBox_TextChanged"/>
                      <TextBlock Grid.Row="3" Text="Raccord vers l’intérieur" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <TextBox x:Name="BeachInnerWidthTextBox" Grid.Row="3" Grid.Column="1" Margin="6,2" Text="32" TextChanged="BeachSettingsTextBox_TextChanged"/>
                      <TextBlock Grid.Row="4" Text="Largeur côté eau" VerticalAlignment="Center"/>
                      <TextBox x:Name="BeachWaterWidthTextBox" Grid.Row="4" Grid.Column="1" Margin="6,2" Text="384" TextChanged="BeachSettingsTextBox_TextChanged"/>
                      <TextBlock Grid.Row="5" Text="Longueur de plage" VerticalAlignment="Center"/>
                      <TextBox x:Name="BeachLengthTextBox" Grid.Row="5" Grid.Column="1" Margin="6,2" Text="2048" TextChanged="BeachSettingsTextBox_TextChanged"/>
                    </Grid>
                    <CheckBox x:Name="BeachFeatherEdgesCheckBox" IsChecked="True" Visibility="Collapsed"/>
                    <CheckBox x:Name="BeachAutoStraightCheckBox" IsChecked="True" Visibility="Collapsed"/>
                    <CheckBox x:Name="BeachSnapToShoreCheckBox" IsChecked="True" Visibility="Collapsed"/>
                    <Button Margin="0,6,0,0" Height="28" Click="ResetBeachProfile_Click">Profil conseillé (inspiré vanilla)</Button>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#315D31" Text="Cliquez près du contour vert : le tronçon choisi devient orange. Étirez les carrés le long du contour, ou déplacez le losange cyan. Le profil conseillé utilise un raccord intérieur de 1 case, 3 cases de sable et 12 cases de pente marine (32 unités = 1 case). Une seule ligne de côte continue rend tout le rivage utilisable par les comptoirs et les bâtiments de pêche."/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                      <Button Margin="2" Height="30" Click="ApplyBeachButton_Click">Créer la plage jouable</Button>
                      <Button Margin="2" Height="30" Click="ResetBeachButton_Click">Réinitialiser</Button>
                    </UniformGrid>
                  </StackPanel>
                </Expander>
                <Expander Header="Planter des arbres" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock Text="Choisissez l’outil Arbres puis cliquez ou peignez sur la terre. Les arbres verts sont un aperçu avant application." TextWrapping="Wrap"/>
                    <DockPanel Margin="0,8,0,3">
                      <TextBlock Text="Densité" VerticalAlignment="Center"/>
                      <TextBlock DockPanel.Dock="Right" Width="54" TextAlignment="Right" Text="{Binding ElementName=TreeDensitySlider, Path=Value, StringFormat={}{0:0}%}"/>
                    </DockPanel>
                    <Slider x:Name="TreeDensitySlider" Minimum="5" Maximum="100" Value="35" TickFrequency="5"/>
                    <TextBlock x:Name="TreeBiomeTextBlock" Margin="0,5,0,0" Foreground="#315D31" Text="Arbres adaptés au biome actif." TextWrapping="Wrap"/>
                    <TextBlock x:Name="TreeStatusTextBlock" Margin="0,6,0,0" Foreground="#315D31" Text="Aucun arbre en attente." TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                      <Button x:Name="ApplyTreesButton" Margin="2" Height="32" Click="ApplyTreesButton_Click">Appliquer les arbres</Button>
                      <Button Margin="2" Height="32" Click="ResetTreesButton_Click">Effacer l’aperçu</Button>
                    </UniformGrid>
                  </StackPanel>
                </Expander>
                <Expander Header="Créer une rivière" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock Text="Cliquez les points depuis la source vers l’embouchure. Les virages sont arrondis ; le lit conserve une profondeur fixe sous le terrain local et l’eau recouvre légèrement les berges." TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="82"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="Largeur (cases)" VerticalAlignment="Center"/>
                      <TextBox x:Name="RiverWidthTextBox" Grid.Row="0" Grid.Column="1" Margin="6,2" Text="5"/>
                      <TextBlock Grid.Row="1" Text="Profondeur du lit" VerticalAlignment="Center"/>
                      <TextBox x:Name="RiverDepthTextBox" Grid.Row="1" Grid.Column="1" Margin="6,2" Text="2"/>
                      <TextBlock Grid.Row="2" Text="Portée irrigation" VerticalAlignment="Center"/>
                      <TextBox x:Name="RiverIrrigationRadiusTextBox" Grid.Row="2" Grid.Column="1" Margin="6,2" Text="10"/>
                    </Grid>
                    <CheckBox x:Name="ManualRiverSlotModeCheckBox" Margin="0,6,0,0" Checked="ManualRiverSlotMode_Changed" Unchecked="ManualRiverSlotMode_Changed" Content="Mode : placer les accroches manuellement"/>
                    <TextBlock x:Name="RiverSlotHelpTextBlock" Margin="0,3,0,0" Foreground="#686028" Text="Dessinez d’abord la rivière, activez ce mode, puis cliquez près du tracé uniquement aux endroits souhaités. Le côté du clic choisit la berge." TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,5,0,0">
                      <Button Margin="2" Height="30" Click="RemoveLastRiverSlotButton_Click">Retirer la dernière accroche</Button>
                      <Button Margin="2" Height="30" Click="ClearRiverSlotsButton_Click">Effacer les accroches</Button>
                    </UniformGrid>
                    <TextBlock Margin="0,4,0,0" Foreground="#686028" Text="DLC06/Colony02 : la zone irriguée qui transforme la végétation est créée automatiquement." TextWrapping="Wrap"/>
                    <TextBlock x:Name="RiverStatusTextBlock" Margin="0,6,0,0" Foreground="#245F7A" Text="Aucun tracé de rivière." TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                      <Button x:Name="ApplyRiverButton" Margin="2" Height="32" Click="ApplyRiverButton_Click">Créer la rivière</Button>
                      <Button Margin="2" Height="32" Click="ResetRiverButton_Click">Effacer le tracé</Button>
                    </UniformGrid>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Île">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Expander Header="Jeu de matériaux / biome" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock Text="material_sets" FontWeight="SemiBold"/>
                    <ComboBox x:Name="GpuMaterialSetComboBox" Height="28" Margin="0,5,0,0" IsTextSearchEnabled="True" IsEditable="True" IsReadOnly="True" SelectionChanged="GpuMaterialSetComboBox_SelectionChanged" ToolTip="Jeux de matériaux inclus dans le programme"/>
                    <TextBlock x:Name="GpuMaterialSetStatusTextBlock" Margin="0,5,0,0" Foreground="#315D31" TextWrapping="Wrap" Text="Le choix est partagé avec l’éditeur de matériaux et inscrit dans le RD3D."/>
                  </StackPanel>
                </Expander>
                <Expander Header="Dessiner l’emprise de l’île" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock x:Name="IslandMaximumSizeTextBlock" Text="Taille maximale XML : lecture..." TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Les outils Ajouter/Retirer utilisent le rayon et le motif du pinceau. L’extension fine active le chunk technique, mais ne fait sortir de l’eau que la forme dessinée."/>
                    <CheckBox x:Name="FineTerrainExtensionCheckBox" Content="Extension fine : garder le reste du chunk sous l’eau" IsChecked="True" Margin="0,7,0,0"/>
                    <DockPanel Margin="0,6,0,0">
                      <TextBlock Text="Hauteur de la nouvelle terre" VerticalAlignment="Center"/>
                      <TextBox x:Name="FineTerrainHeightTextBox" DockPanel.Dock="Right" Width="72" Margin="8,0,0,0" Text="64" ToolTip="Hauteur décodée, comme la hauteur de plage"/>
                    </DockPanel>
                    <TextBlock x:Name="FootprintStatusTextBlock" Margin="0,6,0,0" Text="Emprise du projet chargée." TextWrapping="Wrap" Foreground="#315D31"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                      <Button x:Name="ApplyFootprintButton" Margin="2" Height="32" Click="ApplyFootprintButton_Click">Appliquer l’emprise</Button>
                      <Button Margin="2" Height="32" Click="ResetFootprintButton_Click">Annuler le dessin</Button>
                    </UniformGrid>
                    <Button x:Name="ExpandIslandMaximumButton" Margin="0,8,0,0" Height="32" Click="ExpandIslandMaximumButton_Click">Créer et charger l’extension maximale</Button>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Réglages">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Expander Header="Maillage fusionné" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <DockPanel>
                      <TextBlock Text="Niveau de détail (LOD)" VerticalAlignment="Center"/>
                      <ComboBox x:Name="LodComboBox" Width="80" Margin="8,0,0,0" SelectionChanged="LodComboBox_SelectionChanged"/>
                    </DockPanel>
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="Toutes les pages du LOD sont assemblées et leurs bords communs sont soudés en une seule surface éditable."/>
                    <Button Margin="0,8,0,0" Height="30" Click="ReloadGpuButton_Click">Reconstruire le maillage fusionné</Button>
                    <Button Margin="0,6,0,0" Height="30" Click="FrameMaximumArea_Click">Cadrer la limite maximale (grise)</Button>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="Gris : limite du fichier. Le terrain et l’emprise sont modifiables jusqu’au bord."/>
                  </StackPanel>
                </Expander>
                <Expander Header="Importer un terrain OBJ" Margin="0,0,0,10" IsExpanded="False">
                  <StackPanel Margin="8">
                    <TextBlock Text="L'OBJ remplace le maillage du LOD affiché. Tous les éléments reconnus comme terrain sont conservés ; les bâtiments, arbres et autres décors sont écartés automatiquement. X/Z et les hauteurs sont ajustés à l'île. Les UV, normales, tangentes et Raw3..Raw7 sont créés automatiquement." TextWrapping="Wrap"/>
                    <CheckBox x:Name="ObjFitFootprintCheckBox" Content="Ajuster X/Z à l'emprise active" IsChecked="True" Margin="0,8,0,2"/>
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="82"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="Précision (unités)" VerticalAlignment="Center"/>
                      <TextBox x:Name="ObjGridStepTextBox" Grid.Row="0" Grid.Column="1" Margin="6,2" Text="32" ToolTip="32 correspond à une case de jeu"/>
                      <TextBlock Grid.Row="1" Text="Lissage" VerticalAlignment="Center"/>
                      <TextBox x:Name="ObjSmoothingTextBox" Grid.Row="1" Grid.Column="1" Margin="6,2" Text="2" ToolTip="Nombre de passages de lissage, de 0 à 8"/>
                    </Grid>
                    <Button x:Name="ImportObjTerrainButton" Margin="0,8,0,0" Height="32" Click="ImportObjTerrainButton_Click">Charger un fichier OBJ comme terrain</Button>
                    <TextBlock x:Name="ObjImportStatusTextBlock" Margin="0,6,0,0" Text="Aucun OBJ importé. Les éléments de terrain et leur plage de hauteur sont détectés automatiquement." Foreground="#315D31" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
                <Button Height="36" Margin="0,4,0,6" Click="RepairHeightPagesButton_Click" ToolTip="Recalcule toutes les pages de hauteur à partir du maillage fin. À utiliser pour une île déjà éditée présentant des cassures en jeu, puis exporter le ZIP complet.">Réparer les raccords du rendu proche</Button>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#555" BorderThickness="1" Background="#101217">
        <hx:Viewport3DX x:Name="GpuViewport" BackgroundColor="#101217" ShowCoordinateSystem="True" ShowViewCube="True" EnableDpiScale="True" EnableSwapChainRendering="False" UseDefaultGestures="False" FXAALevel="Low" PreviewMouseMove="GpuViewport_MouseMove" PreviewMouseLeftButtonDown="GpuViewport_PreviewMouseLeftButtonDown" MouseLeave="GpuViewport_MouseLeave" PreviewMouseRightButtonUp="GpuViewport_PreviewMouseRightButtonUp" PreviewMouseWheel="GpuViewport_PreviewMouseWheel" PreviewMouseLeftButtonUp="GpuViewport_PreviewMouseLeftButtonUp">
          <hx:Viewport3DX.InputBindings>
            <MouseBinding Command="hx:ViewportCommands.Rotate" Gesture="RightClick"/>
            <MouseBinding Command="hx:ViewportCommands.Pan" Gesture="MiddleClick"/>
          </hx:Viewport3DX.InputBindings>
          <hx:AmbientLight3D Color="#686868"/>
          <hx:DirectionalLight3D Color="White" Direction="-0.35,-0.75,-0.4"/>
          <hx:DirectionalLight3D Color="#8090A8" Direction="0.45,-0.2,0.25"/>
          <hx:MeshGeometryModel3D x:Name="TerrainModel" CullMode="None" IsHitTestVisible="True" MouseDown3D="TerrainModel_MouseDown3D"/>
          <hx:MeshGeometryModel3D x:Name="FootprintHitPlaneModel" CullMode="None" IsHitTestVisible="False" IsTransparent="True" MouseDown3D="TerrainModel_MouseDown3D"/>
          <hx:MeshGeometryModel3D x:Name="BeachPreviewFillModel" CullMode="None" DepthBias="-146" IsHitTestVisible="False" IsTransparent="True" IsRendering="False"/>
          <hx:LineGeometryModel3D x:Name="BeachPreviewHaloModel" Color="#E8000000" Thickness="18" DepthBias="-148" IsHitTestVisible="False" IsRendering="False"/>
          <hx:LineGeometryModel3D x:Name="BeachPreviewModel" Color="#FFFF7A00" Thickness="11" DepthBias="-152" IsHitTestVisible="False" IsRendering="False"/>
