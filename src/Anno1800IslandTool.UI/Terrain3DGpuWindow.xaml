      <!-- La forme du pinceau est volontairement dessinée par WPF au-dessus
                 du SwapChain DirectX. Elle ne dépend donc plus de l'acceptation
                 d'une nouvelle géométrie par le moteur 3D pour suivre la souris. -->
      <Canvas x:Name="BrushOverlayCanvas" Grid.Row="0" Margin="1" Panel.ZIndex="20" ClipToBounds="True" IsHitTestVisible="False">
        <Polyline x:Name="BrushOverlayPolyline" Stroke="#FFFFD400" StrokeThickness="4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
