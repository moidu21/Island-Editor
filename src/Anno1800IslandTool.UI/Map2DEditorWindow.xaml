<Window x:Class="Anno1800IslandTool.UI.Map2DEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vue 2D - slots / zones"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Preview" VerticalAlignment="Center"/>
            <ComboBox x:Name="PreviewSelectorComboBox" Width="360" Margin="8,0,0,0" SelectionChanged="PreviewSelectorComboBox_SelectionChanged"/>
            <Button Width="120" Height="30" Margin="8,0,0,0" Click="RefreshButton_Click">Rafraîchir</Button>
            <Button Width="140" Height="30" Margin="8,0,0,0" Click="ApplyButton_Click">Appliquer au projet</Button>
            <CheckBox x:Name="AutoRefreshCheckBox" Margin="12,6,0,0" Content="Rafraîchir overlay auto" IsChecked="True"/>
            <TextBlock x:Name="ModeTextBlock" Margin="16,6,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,8">
                    <Button Width="110" Height="30" Margin="0,0,8,0" Click="SelectModeButton_Click">Sélection</Button>
                    <Button Width="110" Height="30" Margin="0,0,8,0" Click="MoveSlotModeButton_Click">Déplacer slot</Button>
                    <Button Width="120" Height="30" Margin="0,0,8,0" Click="MoveSpawnModeButton_Click">Déplacer spawn</Button>
                    <Button Width="120" Height="30" Margin="0,0,8,0" Click="MoveGameDataObjectModeButton_Click">Déplacer GD obj</Button>
                    <Button Width="110" Height="30" Margin="0,0,8,0" Click="AddSlotModeButton_Click">Ajouter slot</Button>
                    <Button Width="120" Height="30" Margin="0,0,8,0" Click="AddSpawnModeButton_Click">Ajouter spawn</Button>
                    <Button Width="120" Height="30" Margin="0,0,8,0" Click="SetZoneTopLeftModeButton_Click">Zone coin HG</Button>
                    <Button Width="120" Height="30" Margin="0,0,8,0" Click="SetZoneBottomRightModeButton_Click">Zone coin BD</Button>
                    <Button Width="110" Height="30" Click="ClearModeButton_Click">Quitter mode</Button>
                </WrapPanel>

                <Border x:Name="MapViewportBorder" Grid.Row="1" BorderBrush="#BBB" BorderThickness="1" Background="#222">
                    <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                        <Canvas x:Name="MapCanvas" Background="Transparent" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown" MouseMove="MapCanvas_MouseMove" MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp" MouseRightButtonDown="MapCanvas_MouseRightButtonDown" MouseRightButtonUp="MapCanvas_MouseRightButtonUp"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Filtres d'affichage" Margin="0,0,0,8">
                        <WrapPanel Margin="6">
                            <CheckBox x:Name="ShowActiveMapRectCheckBox" Content="ActiveMapRect" IsChecked="True" Margin="0,0,10,6" Checked="OverlayFilter_Changed" Unchecked="OverlayFilter_Changed"/>
                            <CheckBox x:Name="ShowPlayableAreaCheckBox" Content="PlayableArea" IsChecked="True" Margin="0,0,10,6" Checked="OverlayFilter_Changed" Unchecked="OverlayFilter_Changed"/>
                            <CheckBox x:Name="ShowSlotsCheckBox" Content="Slots" IsChecked="True" Margin="0,0,10,6" Checked="OverlayFilter_Changed" Unchecked="OverlayFilter_Changed"/>
                            <CheckBox x:Name="ShowSpawnsCheckBox" Content="Spawns" IsChecked="True" Margin="0,0,10,6" Checked="OverlayFilter_Changed" Unchecked="OverlayFilter_Changed"/>
                            <CheckBox x:Name="ShowGameDataObjectsCheckBox" Content="GameData objects" IsChecked="True" Margin="0,0,10,6" Checked="OverlayFilter_Changed" Unchecked="OverlayFilter_Changed"/>
                        </WrapPanel>
                    </GroupBox>

                    <TextBlock Text="PlayableArea L / T / R / B" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                        <TextBox x:Name="PlayableLeftTextBox" Width="60"/>
                        <TextBox x:Name="PlayableTopTextBox" Width="60" Margin="6,0,0,0"/>
                        <TextBox x:Name="PlayableRightTextBox" Width="60" Margin="6,0,0,0"/>
                        <TextBox x:Name="PlayableBottomTextBox" Width="60" Margin="6,0,0,0"/>
                    </StackPanel>

                    <GroupBox Header="Slots" Margin="0,0,0,8" Height="190">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Width="100" Height="28" Click="AddSlotButton_Click">Ajouter</Button>
                                <Button Width="100" Height="28" Margin="8,0,0,0" Click="RemoveSlotButton_Click">Supprimer</Button>
                            </StackPanel>
                            <DataGrid x:Name="SlotsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SlotsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ObjectId" Binding="{Binding ObjectIdText, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                    <DataGridTextColumn Header="Guid" Binding="{Binding ObjectGuid, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                    <DataGridTextColumn Header="X" Binding="{Binding PosXText, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    <DataGridTextColumn Header="Z" Binding="{Binding PosZText, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Spawns" Margin="0,0,0,8" Height="170">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Width="100" Height="28" Click="AddSpawnButton_Click">Ajouter</Button>
                                <Button Width="100" Height="28" Margin="8,0,0,0" Click="RemoveSpawnButton_Click">Supprimer</Button>
                            </StackPanel>
                            <DataGrid x:Name="SpawnsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SpawnsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTextColumn Header="X" Binding="{Binding PosXText, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    <DataGridTextColumn Header="Z" Binding="{Binding PosZText, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="GameData objects" Margin="0,0,0,8" Height="260">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Width="105" Height="28" Margin="0,0,8,0" Click="MoveGameDataObjectModeButton_Click">Déplacer GD</Button>
                                <Button Width="100" Height="28" Margin="0,0,8,0" Click="ReloadGameDataObjectsButton_Click">Recharger</Button>
                                <Button Width="110" Height="28" Click="ApplyGameDataObjectsButton_Click">Appliquer GD</Button>
                            </StackPanel>
                            <DataGrid x:Name="GameDataObjectsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="GameDataObjectsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="C" Binding="{Binding ContainerIndexText}" Width="35" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="#" Binding="{Binding ObjectIndexText}" Width="35" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="guid" Binding="{Binding Guid}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ObjectId}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Folder" Binding="{Binding FolderId}" Width="55" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="X" Binding="{Binding PosXText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Y" Binding="{Binding PosYText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="Z" Binding="{Binding PosZText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Infos" Margin="0,0,0,8" Height="180">
                        <TextBox x:Name="InfoTextBox" FontFamily="Consolas" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Astuce : garde le clic droit pour déplacer la vue. Utilise Ctrl + molette pour zoomer/dézoomer. Le clic gauche sert à sélectionner ou éditer selon le mode. Clique 'Appliquer au projet' puis exporte le ZIP depuis la fenêtre principale." Foreground="#555"/>
    </Grid>
</Window>
