<Window x:Class="Anno1800IslandTool.UI.NativeIslandWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Îles du jeu et conversion" Width="960" Height="690" MinWidth="700" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="BrowserHeader">
   <TextBlock Text="Dossier du jeu ou maindata"/>
   <DockPanel Margin="0,5,0,10"><Button DockPanel.Dock="Right" Content="Parcourir…" Click="ChooseGame_Click" Padding="12,4"/><TextBox x:Name="GameFolder" MinHeight="28"/></DockPanel>
   <WrapPanel><Button x:Name="ScanButton" Content="Rechercher les îles" Click="Scan_Click" Padding="14,6"/><Button Content="Interpréter une île extraite" Click="OpenExtracted_Click" Padding="14,6" Margin="8,0,0,0"/><TextBlock Text="Rechercher" Margin="16,6,6,0"/><TextBox x:Name="Search" Width="180" TextChanged="Search_Changed"/></WrapPanel>
   <TextBlock Text="Chaque variante est séparée. Le nom et le chemin permettent de distinguer les versions avec rivière." TextWrapping="Wrap" Margin="0,8,0,8"/>
  </StackPanel>
  <DataGrid x:Name="Islands" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" Margin="0,4,0,10">
   <DataGrid.Columns><DataGridTextColumn Header="Île" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Chemin" Binding="{Binding InternalPath}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <TextBox x:Name="Log" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Fermer" Click="Cancel_Click" Padding="16,7"/><Button x:Name="ActionButton" Content="Ouvrir l’île sélectionnée" Click="Action_Click" Padding="16,7" HorizontalAlignment="Left"/></DockPanel>
 </Grid>
</Window>
